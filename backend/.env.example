# Application Settings
PROJECT_NAME="Refund Evidence Verification API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Database Configuration (SQLite)
DATABASE_URL="sqlite:///./data/refund_verification.db"

# Storage Settings
STORAGE_PATH="./storage"
MAX_VIDEO_SIZE_MB=50
MAX_TEXT_EVIDENCE_LENGTH=5000

# CORS Configuration (JSON array or comma-separated origins)
CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:8000", "http://localhost:8080"]

# Merchant Authentication & Security Settings (Milestone 2)
JWT_SECRET_KEY="change-this-development-secret-minimum-32-chars-length"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Verification Sessions & Public Access (Milestone 5)
VERIFICATION_SESSION_EXPIRY_HOURS=72
CUSTOMER_VERIFICATION_BASE_URL="http://localhost:8000/v"

# ==========================================
# AI CONFIGURATION
# ==========================================

# Google Gemini Vision
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_VISION_PROMPT_VERSION=v1

# Local Ollama Reasoning Model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=60

# Reasoning
LLAMA_REASONING_PROMPT_VERSION=v1

# Adaptive Evidence
MAX_ADAPTIVE_FOLLOWUPS=3


